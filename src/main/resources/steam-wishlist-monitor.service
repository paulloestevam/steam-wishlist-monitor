[Unit]
Description=Monitor Steam Wishlist - Java 25
After=network.target

[Service]
User=paull
WorkingDirectory=/home/paull/steam-wishlist-monitor
# Use o java do sistema (/usr/bin/java) e evite que quebras de linha confiram argumentos fora do ExecStart
# Passe o caminho do chromedriver explicitamente com a propriedade system property
ExecStart=/usr/bin/java -Dwebdriver.chrome.driver=/usr/bin/chromedriver -jar /home/paull/steam-wishlist-monitor/steam-wishlist-monitor-0.0.1-SNAPSHOT.jar --spring.mail.username=paulloestevam@gmail.com --spring.mail.password="jhtm bgml fhwr efyv" --email.sender=paulloestevam@gmail.com --scheduler.time='0 0 11 * * *' --minDiscountPercentage=65
Restart=always
RestartSec=10
# Garante que o systemd gerencie os arquivos de log com as permissões corretas
StandardOutput=append:/home/paull/steam-wishlist-monitor/logs/monitor.log
StandardError=append:/home/paull/steam-wishlist-monitor/logs/monitor.log

[Install]
WantedBy=multi-user.target
